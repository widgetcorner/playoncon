# Copy this file to scripts/.env.local and fill in the values.
# scripts/.env.local is git-ignored — never commit it.
# release-config.sh loads this file for builds, schedule refresh, and stores.

# Google Sheets API v4 key (project: playoncon). Restricted to Sheets API
# only. Rotate in GCP Console → APIs & Credentials if this ever leaks.
SHEETS_API_KEY="paste-rotated-key-here"

# Supabase publishable key (safe to expose by design — the "publishable"
# prefix means it's meant to ship in clients — but kept here for
# consistency and easy rotation).
SUPABASE_PUBLISHABLE_KEY="paste-supabase-publishable-key-here"

# App Store Connect API metadata (not private key contents).
ASC_KEY_ID=""
ASC_ISSUER_ID=""
# Optional override; default is ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8.
# ASC_PRIVATE_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_<ID>.p8"

# Optional override; default is ~/.playconsole/playoncon-publisher.json.
# POC_PLAY_JSON_KEY="$HOME/.playconsole/playoncon-publisher.json"

# Public values default in release-config.sh. Override only when they change.
# SHEET_ID="..."
# SHEET_GIDS="2027634205,1820056449"
# EVENT_THURSDAY="2026-07-02"
# CSV_URLS="..." # Override if moving away from the default two tabs.
# SUPABASE_URL="..."
# Set SUPABASE_URL="" and SUPABASE_PUBLISHABLE_KEY="" to disable live carts.
